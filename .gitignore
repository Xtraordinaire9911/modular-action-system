# The model-versus-rules demo: the recording plus a frozen copy of the calls it
# made. Kept in history on purpose - it is the only checked-in proof that an
# external model provider was configured and actually answered.
!artifacts/llm_demo/
!artifacts/llm_demo/**
# Per-run demo output (screenshots, traces): regenerated on every run.
eval_outputs/
# Recorded demo videos. Every run writes one and they are a few MB each, so none
# of them belong in history. The one in the README is hosted by GitHub: drag the
# file into a comment box and it returns a user-attachments URL that plays inline,
# which a repository-relative link does not.
demo_video/
*.webm
# Talk GIFs: 10 MB of frames cut from an mp4 that is already in history.
# scripts/make_talk_gifs.py regenerates them in about a minute.
artifacts/talk_gifs/*.gif
.external_envs/

# Local paper / presentation artifacts
local_docs/
docs/
*.png
!artifacts/friday_generalized_recovery/**/*.png
!artifacts/runtime_recovery_demo/**/*.png
!artifacts/llm_demo/**/*.png

# Local report and presentation drafts. Kept out of the repository: the course
# requires these to be written by hand, so a draft in history invites the wrong
# thing being submitted.
reports/

# API keys live here and nowhere else. Never commit this file.
.env.local
