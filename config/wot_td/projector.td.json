{
  "@context": ["https://www.w3.org/2019/wot/td/v1"],
  "@type": "Thing",
  "id": "projector_A",
  "title": "Smart Projector Room A",
  "securityDefinitions": {
    "nosec_sc": {"scheme": "nosec"}
  },
  "security": "nosec_sc",
  "properties": {
    "power": {
      "type": "string",
      "enum": ["on", "off"],
      "readOnly": false,
      "forms": [{"href": "http://localhost:5001/projector/properties/power"}]
    }
  },
  "actions": {
    "setPower": {
      "input": {"type": "string", "enum": ["on", "off"]},
      "forms": [{"href": "http://localhost:5001/projector/actions/setPower", "htv:methodName": "POST"}]
    }
  }
}
