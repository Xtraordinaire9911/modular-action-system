{
  "@context": ["https://www.w3.org/2019/wot/td/v1"],
  "@type": "Thing",
  "id": "lights_A",
  "title": "Smart Lighting Room A",
  "securityDefinitions": {
    "nosec_sc": {"scheme": "nosec"}
  },
  "security": "nosec_sc",
  "properties": {
    "brightness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "readOnly": false,
      "forms": [{"href": "http://localhost:5001/lights/properties/brightness"}]
    }
  },
  "actions": {
    "setBrightness": {
      "input": {"type": "integer", "minimum": 0, "maximum": 100},
      "forms": [{"href": "http://localhost:5001/lights/actions/setBrightness", "htv:methodName": "POST"}]
    }
  }
}
