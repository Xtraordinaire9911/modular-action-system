{
  "@context": ["https://www.w3.org/2019/wot/td/v1"],
  "@type": "Thing",
  "id": "thermostat_A",
  "title": "Smart Thermostat Room A",
  "securityDefinitions": {
    "nosec_sc": {"scheme": "nosec"}
  },
  "security": "nosec_sc",
  "properties": {
    "targetTemperature": {
      "type": "number",
      "readOnly": false,
      "forms": [{"href": "http://localhost:5001/thermostat/properties/targetTemperature"}]
    },
    "currentTemperature": {
      "type": "number",
      "readOnly": true,
      "forms": [{"href": "http://localhost:5001/thermostat/properties/currentTemperature"}]
    }
  },
  "actions": {
    "setTargetTemperature": {
      "input": {"type": "number", "minimum": 16, "maximum": 30},
      "forms": [{"href": "http://localhost:5001/thermostat/actions/setTargetTemperature", "htv:methodName": "POST"}]
    }
  }
}
